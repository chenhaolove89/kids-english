{
  "poems": [
    {
      "id": "yong-e",
      "title": "咏鹅",
      "author": "骆宾王",
      "dynasty": "唐",
      "stage": "qimeng",
      "lines": ["鹅，鹅，鹅，", "曲项向天歌。", "白毛浮绿水，", "红掌拨清波。"],
      "ttsPinyin": { "曲项向天歌。": { "曲": "qū" } }
    },
    {
      "id": "jing-ye-si",
      "title": "静夜思",
      "author": "李白",
      "dynasty": "唐",
      "stage": "qimeng",
      "lines": ["床前明月光，", "疑是地上霜。", "举头望明月，", "低头思故乡。"]
    },
    {
      "id": "chun-xiao",
      "title": "春晓",
      "author": "孟浩然",
      "dynasty": "唐",
      "stage": "qimeng",
      "lines": ["春眠不觉晓，", "处处闻啼鸟。", "夜来风雨声，", "花落知多少。"],
      "ttsPinyin": { "春眠不觉晓，": { "觉": "jué" } }
    },
    {
      "id": "min-nong",
      "title": "悯农（其二）",
      "author": "李绅",
      "dynasty": "唐",
      "stage": "qimeng",
      "lines": ["锄禾日当午，", "汗滴禾下土。", "谁知盘中餐，", "粒粒皆辛苦。"]
    },
    {
      "id": "hua",
      "title": "画",
      "author": "",
      "dynasty": "",
      "stage": "qimeng",
      "lines": ["远看山有色，", "近听水无声。", "春去花还在，", "人来鸟不惊。"],
      "ttsPinyin": { "春去花还在，": { "还": "hái" } }
    },
    {
      "id": "jiang-nan",
      "title": "江南",
      "author": "汉乐府",
      "dynasty": "汉",
      "stage": "qimeng",
      "lines": ["江南可采莲，", "莲叶何田田。", "鱼戏莲叶间。", "鱼戏莲叶东，", "鱼戏莲叶西，", "鱼戏莲叶南，", "鱼戏莲叶北。"]
    },
    {
      "id": "deng-guan-que-lou",
      "title": "登鹳雀楼",
      "author": "王之涣",
      "dynasty": "唐",
      "stage": "g12",
      "lines": ["白日依山尽，", "黄河入海流。", "欲穷千里目，", "更上一层楼。"],
      "ttsPinyin": { "更上一层楼。": { "更": "gèng" } }
    },
    {
      "id": "feng",
      "title": "风",
      "author": "李峤",
      "dynasty": "唐",
      "stage": "g12",
      "lines": ["解落三秋叶，", "能开二月花。", "过江千尺浪，", "入竹万竿斜。"],
      "ttsPinyin": { "解落三秋叶，": { "解": "jiě" } }
    },
    {
      "id": "chi-shang",
      "title": "池上",
      "author": "白居易",
      "dynasty": "唐",
      "stage": "g12",
      "lines": ["小娃撑小艇，", "偷采白莲回。", "不解藏踪迹，", "浮萍一道开。"],
      "ttsPinyin": { "不解藏踪迹，": { "解": "jiě", "藏": "cáng" } }
    },
    {
      "id": "gu-lang-yue-xing",
      "title": "古朗月行（节选）",
      "author": "李白",
      "dynasty": "唐",
      "stage": "g12",
      "lines": ["小时不识月，", "呼作白玉盘。", "又疑瑶台镜，", "飞在青云端。"]
    },
    {
      "id": "cun-ju",
      "title": "村居",
      "author": "高鼎",
      "dynasty": "清",
      "stage": "g12",
      "lines": ["草长莺飞二月天，", "拂堤杨柳醉春烟。", "儿童散学归来早，", "忙趁东风放纸鸢。"],
      "ttsPinyin": {
        "草长莺飞二月天，": { "长": "zhǎng" },
        "儿童散学归来早，": { "散": "sàn" }
      }
    },
    {
      "id": "xiao-chi",
      "title": "小池",
      "author": "杨万里",
      "dynasty": "宋",
      "stage": "g12",
      "lines": ["泉眼无声惜细流，", "树阴照水爱晴柔。", "小荷才露尖尖角，", "早有蜻蜓立上头。"],
      "ttsPinyin": { "小荷才露尖尖角，": { "露": "lù" } }
    },
    {
      "id": "wang-lu-shan-pu-bu",
      "title": "望庐山瀑布",
      "author": "李白",
      "dynasty": "唐",
      "stage": "g34",
      "lines": ["日照香炉生紫烟，", "遥看瀑布挂前川。", "飞流直下三千尺，", "疑是银河落九天。"]
    },
    {
      "id": "jue-ju-huang-li",
      "title": "绝句",
      "author": "杜甫",
      "dynasty": "唐",
      "stage": "g34",
      "lines": ["两个黄鹂鸣翠柳，", "一行白鹭上青天。", "窗含西岭千秋雪，", "门泊东吴万里船。"],
      "ttsPinyin": { "一行白鹭上青天。": { "行": "háng" } }
    },
    {
      "id": "shan-xing",
      "title": "山行",
      "author": "杜牧",
      "dynasty": "唐",
      "stage": "g34",
      "lines": ["远上寒山石径斜，", "白云生处有人家。", "停车坐爱枫林晚，", "霜叶红于二月花。"]
    },
    {
      "id": "qing-ming",
      "title": "清明",
      "author": "杜牧",
      "dynasty": "唐",
      "stage": "g34",
      "lines": ["清明时节雨纷纷，", "路上行人欲断魂。", "借问酒家何处有？", "牧童遥指杏花村。"]
    },
    {
      "id": "jiu-yue-jiu-ri",
      "title": "九月九日忆山东兄弟",
      "author": "王维",
      "dynasty": "唐",
      "stage": "g34",
      "lines": ["独在异乡为异客，", "每逢佳节倍思亲。", "遥知兄弟登高处，", "遍插茱萸少一人。"],
      "ttsPinyin": {
        "独在异乡为异客，": { "为": "wéi" },
        "遍插茱萸少一人。": { "少": "shǎo" }
      }
    },
    {
      "id": "fu-rong-lou",
      "title": "芙蓉楼送辛渐",
      "author": "王昌龄",
      "dynasty": "唐",
      "stage": "g34",
      "lines": ["寒雨连江夜入吴，", "平明送客楚山孤。", "洛阳亲友如相问，", "一片冰心在玉壶。"]
    },
    {
      "id": "feng-qiao-ye-bo",
      "title": "枫桥夜泊",
      "author": "张继",
      "dynasty": "唐",
      "stage": "g56",
      "lines": ["月落乌啼霜满天，", "江枫渔火对愁眠。", "姑苏城外寒山寺，", "夜半钟声到客船。"]
    },
    {
      "id": "huang-he-lou",
      "title": "黄鹤楼送孟浩然之广陵",
      "author": "李白",
      "dynasty": "唐",
      "stage": "g56",
      "lines": ["故人西辞黄鹤楼，", "烟花三月下扬州。", "孤帆远影碧空尽，", "唯见长江天际流。"]
    },
    {
      "id": "bo-chuan-gua-zhou",
      "title": "泊船瓜洲",
      "author": "王安石",
      "dynasty": "宋",
      "stage": "g56",
      "lines": ["京口瓜洲一水间，", "钟山只隔数重山。", "春风又绿江南岸，", "明月何时照我还。"],
      "ttsPinyin": {
        "钟山只隔数重山。": { "重": "chóng" },
        "明月何时照我还。": { "还": "huán" }
      }
    },
    {
      "id": "zhu-shi",
      "title": "竹石",
      "author": "郑燮",
      "dynasty": "清",
      "stage": "g56",
      "lines": ["咬定青山不放松，", "立根原在破岩中。", "千磨万击还坚劲，", "任尔东西南北风。"],
      "ttsPinyin": { "千磨万击还坚劲，": { "劲": "jìng" } }
    },
    {
      "id": "shi-er",
      "title": "示儿",
      "author": "陆游",
      "dynasty": "宋",
      "stage": "g56",
      "lines": ["死去元知万事空，", "但悲不见九州同。", "王师北定中原日，", "家祭无忘告乃翁。"]
    },
    {
      "id": "chang-ge-xing",
      "title": "长歌行（节选）",
      "author": "汉乐府",
      "dynasty": "汉",
      "stage": "g56",
      "lines": ["百川东到海，", "何时复西归？", "少壮不努力，", "老大徒伤悲。"],
      "ttsPinyin": { "少壮不努力，": { "少": "shào" } }
    }
  ]
}
