# Azure Speech(方案B 中文音频重生成)——复制为 .env.local 并填入真实值
# 创建路径:portal.azure.com → 创建资源 → Speech → 免费层 F0
# 区域如 eastasia / japaneast / southeastasia,与资源所在 Region 一致
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 有道英语语音合成：appKey 是应用 ID，APP_SECRET 是应用密钥，无需第三个 KEY。
# 仅生成工具读取，不打包到网页。美式有雅婷 / 英式有小英。
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=
